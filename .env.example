# Copy to .env and fill in what you need. Nothing here is required to start:
# with no values at all the app runs in demo mode (fake embeddings, offline
# extractive answers, in-memory index of data/corpus).

# --- Answers ---------------------------------------------------------------
# The model id is a config value, not a constant in the code. Check the provider
# docs for what is current; this project was written against the Claude list that
# includes claude-sonnet-5-5.
CLAUDE_MODEL=
ANTHROPIC_API_KEY=

# --- Embeddings ------------------------------------------------------------
# fake   = deterministic local vectors, no key, no network. Good for tests and
#          plumbing. Not a measure of search quality.
# voyage = real embeddings at https://api.voyageai.com/v1/embeddings
EMBEDDING_PROVIDER=fake
VOYAGE_API_KEY=
VOYAGE_MODEL=
# Must match the column in db/schema.sql. Voyage allows 256, 512, 1024, 2048.
EMBEDDING_DIMENSIONS=256

# --- Storage ---------------------------------------------------------------
# Empty means the app indexes data/corpus into memory and needs nothing installed.
# Set this to use Postgres with pgvector (docker compose up -d).
DATABASE_URL=

# --- Retrieval and chunking ------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
# Cosine floor below which an answer becomes a refusal. Retrieval also refuses when
# the best match contains no distinctive query term, which is what catches an
# out-of-domain question on a small corpus. Tune both on your own corpus.
RETRIEVAL_WEAK_SCORE=0.02

# --- Agent loop bounds -----------------------------------------------------
AGENT_MAX_STEPS=6
AGENT_MAX_SPEND_USD=0.25
COST_PER_M_INPUT_USD=3
COST_PER_M_OUTPUT_USD=15
